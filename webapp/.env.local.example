# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- NextAuth ---
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# --- Google OAuth (Google Cloud Console > APIs & Services > Credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Google Apps Script backend ---
# The /exec URL from Deploy > New deployment > Web app
GAS_WEB_APP_URL=
# Must match the SHARED_SECRET Script Property set in the Apps Script project
GAS_SHARED_SECRET=
